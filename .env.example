# ─────────────────────────────────────────────────────────────
# DayFlow 환경 변수 예시
# 이 파일만 커밋합니다. 실제 값은 .env 에 두고 절대 커밋하지 마세요.
# 운영 환경에서는 GitHub Secrets 로 관리합니다.
# ─────────────────────────────────────────────────────────────

# ── 클라이언트 노출 값 (VITE_ 접두사는 번들에 포함됩니다) ──
# 비밀 키는 절대 VITE_ 접두사로 두지 마세요.
VITE_APP_NAME=DayFlow
VITE_APP_BASE_URL=http://localhost:5173

# 서버 프록시 주소 (LLM·지도 API 호출은 반드시 이 프록시를 경유)
VITE_API_BASE_URL=http://localhost:8787

# Web Push 공개 키 (VAPID public key — 공개되어도 안전한 값)
VITE_VAPID_PUBLIC_KEY=

# Supabase 공개 값 (STEP 4에서 사용, RLS 필수)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── 서버 전용 값 (클라이언트 번들에 절대 포함하지 않음) ──
# VAPID 개인 키 — 푸시 발송 서명용
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── LLM (챗봇·음성 비서) ──
# OpenRouter 를 통해 Claude 를 호출한다.
# 절대 VITE_ 접두사를 붙이지 말 것. 붙이면 클라이언트 번들에 그대로 들어간다.
# 서버 프록시(server/)에서만 읽는다.
OPENROUTER_API_KEY=
# OpenRouter 대시보드에서 통계·순위 표시에 쓰이는 선택 값
OPENROUTER_SITE_URL=https://charlieyh-cloud.github.io/dayflow/
OPENROUTER_APP_NAME=DayFlow

# Anthropic 을 직접 쓸 경우의 대안 (둘 중 하나만 채우면 된다)
ANTHROPIC_API_KEY=

# 지도 API 키 — 카카오맵 REST (STEP 5)
KAKAO_REST_API_KEY=

# DB 접속 정보 (STEP 4)
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
